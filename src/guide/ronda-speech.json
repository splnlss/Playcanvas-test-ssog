  "captions": [
    {
      "start": 0.0,
      "end": 1.2,
      "text": "My name is Joseph Lobato."
    },
    {
      "start": 1.66,
      "end": 3.16,
      "text": "We're here today on my family ranch."
    },
    {
      "start": 4.44,
      "end": 6.02,
      "text": "And I'm Ronda Lobato."
    },
    {
      "start": 6.82,
      "end": 8.46,
      "text": "I grew up in San Luis."
    },
    {
      "start": 9.14,
      "end": 11.58,
      "text": "This farm is our heaven on earth."
    },
    {
      "start": 13.46,
      "end": 16.42,
      "text": "Unfortunately, this year we're experiencing a drought and it's"
    },
    {
      "start": 16.42,
      "end": 18.6,
      "text": "just extremely horrible."
    },
    {
      "start": 19.26,
      "end": 21.16,
      "text": "Haven't had any water on the property at all."
    },
    {
      "start": 22.44,
      "end": 26.04,
      "text": "Our senior water rights are further down the watershed."
    },
    {
      "start": 26.62,
      "end": 29.44,
      "text": "We essentially get the right to use the water last."
    }
  ],
